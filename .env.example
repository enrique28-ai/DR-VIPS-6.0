# Use these settings on a local development workstation.
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27018/dr_vips_local?replicaSet=dr-vips-local&directConnection=true

# Generate two independent values before starting the backend.
JWT_SECRET=
PENDING_SECRET=

# Credential-free local settings. Keep the frontend CAPTCHA setting in sync.
CAPTCHA_ENABLED=false
APPT_REMINDERS_ENABLED=true
APPT_REMINDER_MINUTES=60

# Optional integrations. See docs/LOCAL_DEVELOPMENT.md before enabling them.
# PROFESSIONAL_ALLOWLIST_ENFORCED=true
# CAPTCHA_PROVIDER=turnstile
# TURNSTILE_EXPECTED_HOSTNAMES=localhost
# TURNSTILE_SECRET_KEY=
# EMAIL_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# API_GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# DEEPL_API_KEY=
